{
  "info": {
    "name": "PharmaSoft S14 - Integración y estabilización",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:8081/api/v1"
    },
    {
      "key": "admin_password",
      "value": ""
    },
    {
      "key": "vendedor_password",
      "value": ""
    },
    {
      "key": "dni_prueba",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Login admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"{{admin_password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"admin_token\",pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login vendedor",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"vendedor\", \"password\": \"{{vendedor_password}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"vendedor_token\",pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "Login fallido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin\", \"password\": \"incorrecta\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Productos página 0, tamaño 20",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}"
          }
        ],
        "url": "{{base}}/productos?pagina=0&tamanio=20"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Página y tamaño\", () => { const r=pm.response.json(); pm.expect(r.pagina).to.eql(0); pm.expect(r.tamanio).to.eql(20); pm.expect(r.contenido.length).to.be.at.most(20); });"
            ]
          }
        }
      ]
    },
    {
      "name": "Productos página 0, tamaño 100",
      "request": {
        "method": "GET",

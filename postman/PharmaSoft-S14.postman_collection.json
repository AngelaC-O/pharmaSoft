            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Página y tamaño\", () => { const r=pm.response.json(); pm.expect(r.pagina).to.eql(0); pm.expect(r.tamanio).to.eql(100); pm.expect(r.contenido.length).to.be.at.most(100); });"
            ]
          }
        }
      ]
    },
